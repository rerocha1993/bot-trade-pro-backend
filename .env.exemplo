# Copie para .env e preencha. O conselho não usa chave de corretora: só lê dados públicos.

# --- Telegram (opcional): avisos no celular ---------------------------------
# Crie um bot com o @BotFather e pegue o chat_id com o @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Serviço de avisos --------------------------------------------------------
# 1 (padrão) liga; 0 desliga. O painel e as nuvens funcionam com ele desligado.
SERVICO_AVISOS=1

# --- Log ----------------------------------------------------------------------
LOG_LEVEL=INFO
