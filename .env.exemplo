# Bot Trade Pro - copie para .env e preencha. Nunca versione o .env.

# --- Bybit: conta principal -------------------------------------------------
BYBIT_API_KEY_TESTNET=
BYBIT_SECRET_KEY_TESTNET=
BYBIT_API_KEY_REAL=
BYBIT_SECRET_KEY_REAL=

# --- Bybit: uma subconta por robô -------------------------------------------
# <NOME> = campo `subconta` do robô em maiúsculas, com qualquer caractere fora de A-Z0-9 virando "_".
# Ex.: subconta "scalp-fluxo" -> BYBIT_SUB_SCALP_FLUXO_API_KEY_TESTNET
# BYBIT_SUB_SCALP_API_KEY_TESTNET=
# BYBIT_SUB_SCALP_SECRET_KEY_TESTNET=
# BYBIT_SUB_DAYTRADE_API_KEY_TESTNET=
# BYBIT_SUB_DAYTRADE_SECRET_KEY_TESTNET=
# BYBIT_SUB_SWING_API_KEY_TESTNET=
# BYBIT_SUB_SWING_SECRET_KEY_TESTNET=
# BYBIT_SUB_HEDGE_API_KEY_TESTNET=
# BYBIT_SUB_HEDGE_SECRET_KEY_TESTNET=

# --- Banco (SQL Server) -----------------------------------------------------
# DATABASE_URL tem prioridade; sem ela, os campos abaixo montam a string ODBC.
DATABASE_URL=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=dbo_trading_bot
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no

# --- Alertas ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opcionais --------------------------------------------------------------
COINGLASS_API_KEY=
CALIBRACAO_ARQUIVO=
